      "id": "T1",
      "label": "valid: custody handoff and container opening",
      "expected": {"valid": true},
      "notes": "Baseline. Every state change is licensed by an event.",
      "steps": [
        {"event": {"action": "take", "actor": "jake", "obj": "lantern"}},
