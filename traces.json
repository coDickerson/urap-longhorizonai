        {"event": {"action": "move", "actor": "marcus", "to": "garden"}},
        {"event": {"action": "repair", "actor": "marcus", "obj": "lantern"}}
      ]
    },
    {
      "id": "T3",
      "label": "valid: key leaves the chest and changes hands twice",
      "expected": {"valid": true},
      "notes": "The key legitimately occupies four different places. Frequent legitimate motion is the other thing an over-eager judge tends to flag.",
      "steps": [
        {"event": {"action": "open", "actor": "marcus", "container": "chest"}},
        {"event": {"action": "take", "actor": "marcus", "obj": "key"}},
